# --- System ---
PUID=1000
PGID=1000
TZ=Asia/Taipei

# --- Path Mappings ---
# Main media & completed downloads storage (ext4)
DATA_ROOT=/mnt/storage/MediaServer
# Persistent SSD staging directory for incomplete downloads (set to a local SSD path, e.g. /home/<user>/tmp/MediaServerTemp; avoid /tmp)
TEMP_ROOT=/mnt/storage/MediaServerTemp
